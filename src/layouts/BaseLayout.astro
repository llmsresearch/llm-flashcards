---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Absolute-from-root path to the social preview image, e.g. /cards/28_tokenization.jpg */
  ogImage?: string;
  /** Hide the footer for full-height app-style pages. */
  hideFooter?: boolean;
}

const { title, description, ogImage, hideFooter } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = ogImage ? new URL(withBase(ogImage), Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}

    <meta name="twitter:card" content={ogUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase("/")}>LLMs<span>Visual Card</span></a>
        <nav class="nav-links">
          <a href={withBase("/")}>Map</a>
          <a href={withBase("/about")}>About</a>
          <div class="repo-actions" aria-label="GitHub repository actions">
            <div class="repo-action-group">
              <a
                class="repo-action-main"
                href="https://github.com/llmsresearch/llm-flashcards"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Star llmsresearch/llm-flashcards on GitHub"
              >
                <svg class="repo-icon repo-star" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M8 .25a.75.75 0 0 1 .67.41l1.88 3.8 4.2.61a.75.75 0 0 1 .42 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.3l-3.76 1.98a.75.75 0 0 1-1.09-.79l.72-4.18L.83 6.35a.75.75 0 0 1 .42-1.28l4.2-.61L7.33.66A.75.75 0 0 1 8 .25Z"
                  ></path>
                </svg>
                <span>Star</span>
                <span class="repo-count" data-github-count="stars">64</span>
              </a>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {
      !hideFooter && (
        <footer class="site-footer">
          <div class="wrap">
            <span>Visual cards for large language models.</span>
            <span>LLMs Visual Card</span>
          </div>
        </footer>
      )
    }
    <script>
      const repoCountTargets = document.querySelectorAll<HTMLElement>("[data-github-count]");

      async function hydrateGitHubRepoCounts() {
        if (!repoCountTargets.length) return;

        try {
          const response = await fetch("https://api.github.com/repos/llmsresearch/llm-flashcards", {
            headers: { Accept: "application/vnd.github+json" },
          });
          if (!response.ok) return;

          const repo = await response.json();
          const counts: Record<string, number> = {
            stars: repo.stargazers_count,
          };

          repoCountTargets.forEach((target) => {
            const key = target.dataset.githubCount;
            const value = key ? counts[key] : undefined;
            if (typeof value === "number") {
              target.textContent = new Intl.NumberFormat("en", { notation: "compact" }).format(value);
            }
          });
        } catch {
          /* Keep the static fallback counts if GitHub is unavailable. */
        }
      }

      hydrateGitHubRepoCounts();
    </script>
  </body>
</html>
